# Copy this file to .env and fill in real values. Never commit .env.
# Every setting read by app/config.py is listed here (tests/unit/test_config.py checks it).

# --- Gemini API ---
# Your Gemini API key from https://aistudio.google.com/apikey (required, keep secret).
GEMINI_API_KEY=your-gemini-api-key-here
# Model that writes answers (stronger). Check current model ids at ai.google.dev.
ANSWER_MODEL=gemini-3.5-flash
# Model that classifies whether a message is about energy (lighter, cheaper).
CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Optional backup for ANSWER_MODEL when it is overloaded or rate limited; empty = none.
ANSWER_FALLBACK_MODEL=
# Optional backup for CLASSIFIER_MODEL when it is overloaded or rate limited; empty = none.
CLASSIFIER_FALLBACK_MODEL=

# --- Timeouts and retries ---
# Seconds before a single Gemini call is abandoned (0-120).
LLM_TIMEOUT_SECONDS=15.0
# Total tries per call, including the first, for transient errors (1-10).
LLM_MAX_ATTEMPTS=3
# First retry backoff step in seconds; doubles each retry.
LLM_BACKOFF_BASE_SECONDS=1.0
# Longest backoff step in seconds; a longer server retry-after fails fast instead.
LLM_BACKOFF_MAX_SECONDS=8.0

# --- Client-side Gemini rate limit (per model) ---
# Requests per minute allowed to the classifier model(s); keep below the free-tier RPM.
CLASSIFIER_RPM=12.0
# Requests per minute allowed to the answer model(s); keep below the free-tier RPM.
ANSWER_RPM=8.0
# Max seconds a request waits for a free slot before replying "unavailable" (0-60).
RATE_LIMIT_MAX_WAIT_SECONDS=5.0

# --- Guardrails ---
# Longest user message accepted, in characters (G1 input cap).
MAX_INPUT_CHARS=2000
# Minimum classifier confidence (0-1) for a message to be answered; below it, refuse.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# --- REST API ---
# Messages allowed per client IP per minute on the HTTP API.
API_RATE_LIMIT_PER_MINUTE=20
